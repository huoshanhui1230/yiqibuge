# 一起不鸽 · 后端环境变量
# 用法：复制成 .env（.env 不入库）。本地开发按下面的默认值就能跑。
# 小程序端的环境变量在 apps/miniapp/.env.example —— Vite 只认 VITE_ 前缀，所以分两份。

# ---------- 运行环境 ----------
# development | production
NODE_ENV=development
# web = HTTP 服务进程，worker = 定时和延时任务进程。两个进程跑同一份代码、同一个镜像。
APP_ROLE=web
PORT=3000
API_PREFIX=/api/v1

# ---------- MySQL 8 ----------
# timezone=Z 让连接层按 UTC 收发时间，配合 docker-compose.yml 里的 --default-time-zone=+00:00，
# 保证「时间一律存 UTC」不受宿主机时区影响。
# 端口是 3307 不是 3306：docker-compose.yml 把容器映射到 3307，避开机器上已装的 MySQL。
DATABASE_URL=mysql://yiqi:yiqi@127.0.0.1:3307/yiqibuge?timezone=Z

# ---------- Redis（BullMQ 延时队列）----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- 微信能力 ----------
# fake = 本地假实现，real = 真的调微信接口。
# NODE_ENV=production 配 fake 时后端会拒绝启动，防止假开关漏进正式版。
WECHAT_DRIVER=fake

# 假身份：本地联调和接口测试用。请求带 X-Fake-Openid 头可以换成另一个测试用户。
FAKE_DEFAULT_OPENID=openid_test_a
# 格式 openid:昵称，逗号分隔
FAKE_USERS=openid_test_a:小明,openid_test_b:小红,openid_test_c:阿强

# ---------- 微信正式凭据：WECHAT_DRIVER=real 时才需要，第 0 步留空 ----------
WX_APPID=
WX_APP_SECRET=
# 订阅消息模板 ID，逗号分隔。在公众平台申请后填，见 docs/platform-checklist.md
WX_SUBSCRIBE_TEMPLATE_IDS=

# ---------- 图片存储：第 1 阶段再定（docs/spec.md 选型表写的是腾讯云 COS）----------
COS_BUCKET=
COS_REGION=
