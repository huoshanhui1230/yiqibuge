{
  "name": "@yiqi/shared",
  "version": "0.0.0",
  "private": true,
  "description": "前后端共用的类型、时间文案、鸽值计算",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "tsup": "~9.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
