# 开发环境。档位留空，由 vite.config.ts 按平台自动选：
# H5 预览 → mock（假数据），小程序 → local（连本机后端）
VITE_API_MODE=
# 只写到域名和端口，/api/v1 前缀由请求层加
VITE_API_BASE=http://localhost:3000
VITE_CLOUD_ENV=
VITE_CLOUD_SERVICE=
# 站酷快乐体的 https 地址（放在云托管对象存储），留空就用系统字体（docs/decisions.md 第 24 条）
VITE_FONT_DISPLAY_URL=
# local 档默认的测试用户，对应后端 .env 的 FAKE_USERS；组件演示页里可以临时切换
VITE_FAKE_OPENID=openid_test_a
