{
  "name": "@yiqi/miniapp",
  "version": "0.0.0",
  "private": true,
  "description": "一起不鸽 小程序端（uni-app，只编译微信小程序；另有只在开发时用的 H5 预览）",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "uni build -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:h5": "uni build",
    "gen:theme": "tsx scripts/gen-theme-css.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030320261023001",
    "@dcloudio/uni-components": "3.0.0-5030320261023001",
    "@dcloudio/uni-h5": "3.0.0-5030320261023001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030320261023001",
    "@yiqi/shared": "workspace:*",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030320261023001",
    "@types/node": "~24.19.2",
    "tsx": "~4.23.15",
    "typescript": "5.9.3",
    "vite": "5.2.8",
    "vitest": "3.2.7",
    "vue-tsc": "~3.3.13"
  }
}
