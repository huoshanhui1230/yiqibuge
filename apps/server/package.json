{
  "name": "@yiqi/server",
  "version": "0.0.0",
  "private": true,
  "description": "一起不鸽 后端：NestJS 模块化单体，同一份代码另起 Worker 进程",
  "scripts": {
    "build": "nest build",
    "start": "cross-env APP_ROLE=web node dist/main.js",
    "start:dev": "cross-env APP_ROLE=web nest start --watch",
    "start:worker": "cross-env APP_ROLE=worker node dist/worker.js",
    "start:worker:dev": "cross-env APP_ROLE=worker nest start --watch --entryFile worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.1",
    "@nestjs/platform-express": "12.3.1",
    "@nestjs/schedule": "12.0.2",
    "@yiqi/shared": "workspace:*",
    "bullmq": "6.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.1",
    "@swc/core": "1.16.20",
    "@types/node": "~24.19.2",
    "@types/supertest": "7.2.1",
    "cross-env": "~10.1.0",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsx": "~4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
